@page
@model IndexModel
@{
    var s = Model.Online;
    string N(long n) => n.ToString("N0", L.Culture);
    bool en = !L.IsRu;
    ViewData["HeaderOverHero"] = true;
    // Members' own screenshots (wwwroot/gallery), with what is in the frame.
    (string File, string Caption)[] shots =
    [
        ("09-aeroflot-777-above-clouds", "Boeing 777 · Aeroflot"),
        ("03-s7-a320-above-clouds", "Airbus A320 · S7 Airlines"),
        ("05-belavia-737-dusk", "Boeing 737 · Belavia"),
        ("02-aeroflot-a330-sunlit", "Airbus A330 · Aeroflot"),
        ("04-aeroflot-a320-gate", "Airbus A320 · Aeroflot"),
        ("01-ana-a380-sunset", "Airbus A380 · ANA"),
        ("08-aeroflot-a330-runway", "Airbus A330 · Aeroflot"),
    ];
}
@section Head {
  <link rel="stylesheet" href="~/lib/leaflet/leaflet.css">
  <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
  <link rel="preload" as="image" href="/gallery/07-a380-cockpit-dawn.jpg" fetchpriority="high">
}
<div class="ph">

@* ---- First screen: a member's flight at dawn, the promise, who is on the air ---- *@
<section class="ph-hero" aria-labelledby="hero-h">
  <img class="ph-hero-img" src="/gallery/07-a380-cockpit-dawn.jpg" alt="" fetchpriority="high" decoding="async">
  <div class="wrap ph-hero-in">
    <h1 id="hero-h">@L["Fly with live air traffic control"]</h1>
    <p class="ph-lead">@L["A Russian-speaking network for MSFS, X-Plane and Prepar3D pilots and for controllers: voice on the frequencies, flight plans and real procedures."]</p>
    <div class="ph-actions">
      @if (Me.IsSignedIn)
      {
        <a class="btn btn-primary btn-pill" href="/flightplan">@L["File a flight plan"]</a>
        <a class="btn btn-pill ph-btn-light" href="/map">@L["Live map"]</a>
      }
      else
      {
        <a class="btn btn-primary btn-pill" href="/register">@L["Register"]</a>
        <a class="btn btn-pill ph-btn-light" href="/docs/software">@L["Download SkyPilot"]</a>
      }
    </div>
    <a class="ph-live" href="/online">
      <span class="dot@(s.Available && (s.Pilots.Count + Model.OnPosition.Count) > 0 ? "" : " off")" aria-hidden="true"></span>
      @L["Online now"]:
      <b data-live-count="pilots">@(s.Available ? N(s.Pilots.Count) : "—")</b> @L["pilots"] ·
      <b data-live-count="controllers">@(s.Available ? N(Model.OnPosition.Count) : "—")</b> @L["controllers"]
    </a>
  </div>
  <span class="ph-credit">Airbus A380 · @L["a member's screenshot"]</span>
</section>

@* ---- The network, live ---- *@
<section class="ph-sec" aria-labelledby="map-h">
  <div class="wrap">
    <div class="ph-head">
      <div>
        <h2 id="map-h">@L["The whole network on one map"]</h2>
        <p>@L["Who is flying and who is on position, updated every five seconds."]</p>
      </div>
      <a class="chev-link" href="/map">@L["Open the map"]<partial name="_Chevron" /></a>
    </div>
    <div class="ph-map">
      <div id="map" data-compact="1" data-text="@MapTexts.Json(L)" data-signed-in="0" aria-label="@L["Traffic map"]"></div>
    </div>
    <dl class="ph-nums">
      <div><dt>@L["Members"]</dt><dd>@N(Model.MemberCount)</dd></div>
      <div><dt>@L["Sessions in 30 days"]</dt><dd>@N(Model.SessionsMonth)</dd></div>
      <div><dt>@L["Sessions today"]</dt><dd>@N(Model.SessionsToday)</dd></div>
      <div><dt>@L["Upcoming events"]</dt><dd>@N(Model.UpcomingCount)</dd></div>
    </dl>
  </div>
</section>

@* ---- The two programs ---- *@
<section class="ph-sec ph-soft" aria-labelledby="pilot-h">
  <div class="wrap ph-row">
    <div class="ph-text">
      <p class="eyebrow">@L["For pilots"]</p>
      <h2 id="pilot-h">SkyPilot</h2>
      <p class="ph-sub">@L["Start the simulator, type your callsign and you are on the air. SkyPilot finds the simulator and the network by itself."]</p>
      <ul class="ph-points">
        <li>MSFS 2020 · MSFS 2024 · X-Plane 11/12 · Prepar3D v4–v6</li>
        <li>@L["Voice on the frequencies is built in"]</li>
        <li>@L["Your flight plan from the website or SimBrief"]</li>
        <li>@L["Controllers nearby, grouped by position, with frequencies"]</li>
      </ul>
      <a class="btn btn-primary btn-pill" href="/docs/software">@L["Download SkyPilot"]</a>
    </div>
    <figure class="ph-shot">
      <img src="/img/skypilot.jpg" alt="@L["SkyPilot window: radios, messages and controllers nearby"]" loading="lazy" decoding="async" width="1247" height="730">
    </figure>
  </div>
  <div class="wrap ph-row ph-row-flip">
    <div class="ph-text">
      <p class="eyebrow">@L["For controllers"]</p>
      <h2>Network-ATC</h2>
      <p class="ph-sub">@L["A full radar: EuroScope sector files, handoffs, SID and STAR, departure and arrival lists, STCA conflict alerts and ATIS."]</p>
      <ul class="ph-points">
        <li>@L["Voice on the frequencies is built in"]</li>
        <li>@L["Position bookings and events with staffed positions"]</li>
        <li>@L["A clear path from observer to controller through training"]</li>
      </ul>
      <a class="btn btn-pill" href="/docs/ratings">@L["About ratings"]</a>
    </div>
    <figure class="ph-shot ph-photo">
      <img src="/gallery/06-aeroflot-777-apron.jpg" alt="" loading="lazy" decoding="async" width="1920" height="1080">
    </figure>
  </div>
</section>

@* ---- Members' flights ---- *@
<section class="ph-sec" aria-labelledby="shots-h">
  <div class="wrap ph-head">
    <div>
      <h2 id="shots-h">@L["Flown on SkyNetwork"]</h2>
      <p>@L["Screenshots our members sent from their flights."]</p>
    </div>
  </div>
  <div class="ph-strip" tabindex="0" aria-label="@L["Flown on SkyNetwork"]">
    @foreach (var (file, caption) in shots)
    {
      <figure>
        <img src="/gallery/@(file).jpg" alt="@caption" loading="lazy" decoding="async" width="1920" height="1080">
        <figcaption>@caption</figcaption>
      </figure>
    }
  </div>
</section>

@* ---- Getting started ---- *@
<section class="ph-sec" aria-labelledby="start-h">
  <div class="wrap">
    <div class="ph-head">
      <div>
        <h2 id="start-h">@L["Your first flight in half an hour"]</h2>
      </div>
      <a class="chev-link" href="/docs">@L["Getting started"]<partial name="_Chevron" /></a>
    </div>
    <ol class="ph-steps">
      <li><h3>@L["Register"]</h3><p>@L["You get a CID: your number on the network."]</p></li>
      <li><h3>@L["Install SkyPilot"]</h3><p>@L["It connects to the network by itself: no server to type."]</p></li>
      <li><h3>@L["File a plan and connect"]</h3><p>@L["On the website or from SimBrief, then tune the controller's frequency and call."]</p></li>
    </ol>
  </div>
</section>

@* ---- Events and news ---- *@
<section class="ph-sec" aria-labelledby="events-h">
  <div class="wrap">
    <div class="ph-head">
      <div><h2 id="events-h">@L["Upcoming events"]</h2></div>
      <a class="chev-link" href="/events">@L["All events"]<partial name="_Chevron" /></a>
    </div>
    @if (Model.Events.Count == 0)
    {
      <p class="ph-none">@L["No events planned yet."]</p>
    }
    else
    {
      <div class="ph-cards">
        @foreach (var e in Model.Events)
        {
          <a class="card ph-event" href="/events/@e.Id">
            <span class="card-media @(e.BannerUrlIn(en) == null ? "blank" : e.BannerClasses)">
              @if (e.BannerUrlIn(en) is { } banner)
              {
                if (e.BannerWhole) { <img class="banner-fill" src="@banner" alt="" loading="lazy" decoding="async"> }
                <img src="@banner" alt="" loading="lazy" decoding="async">
              }
              else
              {
                <img src="/gallery/08-aeroflot-a330-runway.jpg" alt="" loading="lazy" decoding="async">
              }
            </span>
            <span class="ph-event-body">
              <span class="ph-when">@Format.Span(e.Start, e.End)</span>
              <b>@e.TitleIn(en)</b>
              <span class="muted">@e.SummaryIn(en)</span>
              @if (e.Airports.Length > 0) { <span class="mono muted">@e.Airports</span> }
            </span>
          </a>
        }
      </div>
    }

    <div class="ph-head ph-head-gap">
      <div><h2>@L["News"]</h2></div>
      <a class="chev-link" href="/news">@L["All news"]<partial name="_Chevron" /></a>
    </div>
    @if (Model.News.Count == 0)
    {
      <p class="ph-none">@L["No news yet."]</p>
    }
    else
    {
      <ul class="ph-news">
        @foreach (var n in Model.News)
        {
          <li>
            <span class="ph-when">@Format.Date(n.Created)</span>
            <a href="/news/@n.Id">@n.TitleIn(en)</a>
            <span class="muted">@n.ExcerptIn(en, 150)</span>
          </li>
        }
      </ul>
    }
  </div>
</section>

@* ---- The last word, over a sunset flight ---- *@
<section class="ph-end" aria-labelledby="end-h">
  <img class="ph-end-img" src="/gallery/01-ana-a380-sunset.jpg" alt="" loading="lazy" decoding="async">
  <div class="wrap ph-end-in">
    <h2 id="end-h">@L["See you on the frequency."]</h2>
    @if (Me.IsSignedIn)
    {
      <a class="btn btn-primary btn-pill" href="/flightplan">@L["File a flight plan"]</a>
    }
    else
    {
      <a class="btn btn-primary btn-pill" href="/register">@L["Register"]</a>
    }
  </div>
</section>

</div>

@section Scripts {
  <script src="~/lib/leaflet/leaflet.js"></script>
  <script src="~/js/map.js" asp-append-version="true"></script>
  <script src="~/js/home.js" asp-append-version="true"></script>
}
