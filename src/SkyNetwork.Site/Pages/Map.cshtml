@page "/map"
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@{
    ViewData["Title"] = L["Map"];
    ViewData["HideFooter"] = true;
}
@section Head {
  <link rel="stylesheet" href="~/lib/leaflet/leaflet.css">
}
<div class="map-page">
  <div id="map" aria-label="@L["Traffic map"]" data-text="@MapTexts.Json(L)"
       data-signed-in="@(Me.IsSignedIn ? "1" : "0")" data-xsrf="@(Me.IsSignedIn ? Xsrf.GetAndStoreTokens(HttpContext).RequestToken : "")"></div>
  <div class="map-panel">
    <div class="mp-head">
      <div>
        <div class="eyebrow" style="margin:0 0 4px">@L["On the air"]</div>
        <div><b id="pilot-count">—</b> <span class="muted">@L["pilots"]</span> · <b id="atc-count">—</b> <span class="muted">@L["controllers"]</span></div>
        <div class="muted small" id="map-updated">@L["Loading…"]</div>
      </div>
      <details class="layers-menu">
        <summary title="@L["Layers"]"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 8l10 5 10-5-10-5z"/><path d="m2 13 10 5 10-5"/></svg>@L["Layers"]</summary>
        <div class="menu">
          <label class="check"><input type="checkbox" id="layer-labels" checked> @L["City names"]</label>
          <label class="check"><input type="checkbox" id="fir-toggle" checked> @L["Sector borders"]</label>
          <label class="check"><input type="checkbox" id="layer-codes" checked> @L["Airport codes"]</label>
          <label class="check"><input type="checkbox" id="layer-layouts" checked> @L["Airport diagrams"]</label>
          <button type="button" class="btn btn-small" id="fit-all">@L["Fit all traffic"]</button>
        </div>
      </details>
    </div>
    <div class="mp-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="map-search" list="map-callsigns" placeholder="@L["Callsign, CID or airport"]" autocomplete="off" aria-label="@L["Search the map"]">
    </div>
    <datalist id="map-callsigns"></datalist>
    @* Friends on the air right now (filled by map.js; hidden while there are none). *@
    <section class="mp-friends" id="map-friends" hidden aria-label="@L["Friends online"]"></section>
  </div>
  <aside class="map-card" id="map-card" hidden aria-live="polite"></aside>
</div>
@section Scripts {
  <script src="~/lib/leaflet/leaflet.js"></script>
  <script src="~/js/map.js" asp-append-version="true"></script>
}
