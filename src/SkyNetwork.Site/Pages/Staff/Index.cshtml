@page "/staff"
@model SkyNetwork.Site.Pages.Staff.IndexModel
@{ ViewData["Title"] = L["Management"]; }
<h1 style="font-size:30px">@L["Overview"]</h1>
<div class="kpis">
  <div class="kpi"><b>@Model.Members</b><span>@L["members"]</span></div>
  <div class="kpi"><b>@Model.Online.Pilots.Count / @Model.Online.OnPosition.Count</b><span>@L["pilots / controllers on the air"]</span></div>
  <div class="kpi"><b>@Model.OpenTickets</b><span>@L["open tickets"]</span></div>
  @if (Model.Me.Has(Perm.ApproveRatings)) { <a class="kpi" href="/staff/ratings" style="color:inherit;text-decoration:none"><b>@Model.PendingRatings</b><span>@L["rating requests awaiting approval"]</span></a> }
</div>
@if (Model.Me.Has(Perm.ViewMembers))
{
  <form method="get" action="/staff/members" class="inline-form" style="margin-bottom:28px">
    <label>@L["Find a member"]<input name="q" placeholder="@L["CID, name or email"]" style="width:320px"></label>
    <button class="btn" type="submit">@L["Search"]</button>
  </form>
}
<div class="grid two">
  <div>
    <h2 style="font-size:20px">@L["Most time flying, last 30 days"]</h2>
    <div class="table-wrap"><table><tbody>
      @foreach (var t in Model.TopPilots) { <tr><td><a href="/staff/members/@t.Cid">@t.Name</a></td><td class="num">@Format.Hours(t.Hours)</td></tr> }
      @if (Model.TopPilots.Count == 0) { <tr><td class="muted">@L["No data"]</td></tr> }
    </tbody></table></div>
  </div>
  <div>
    <h2 style="font-size:20px">@L["Most time on position, last 30 days"]</h2>
    <div class="table-wrap"><table><tbody>
      @foreach (var t in Model.TopAtc) { <tr><td><a href="/staff/members/@t.Cid">@t.Name</a></td><td class="num">@Format.Hours(t.Hours)</td></tr> }
      @if (Model.TopAtc.Count == 0) { <tr><td class="muted">@L["No data"]</td></tr> }
    </tbody></table></div>
  </div>
</div>
@if (Model.Audit.Count > 0)
{
  <h2 style="font-size:20px;margin-top:32px">@L["Latest team actions"]</h2>
  <partial name="_AuditTable" model="Model.Audit" />
}
