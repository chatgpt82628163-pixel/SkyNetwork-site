@{
    string path = Context.Request.Path.Value ?? "/";
    string here = path + Context.Request.QueryString;
    string Active(string prefix) => path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    // Theme: "light" / "dark" from the cookie; without it the page follows the system setting.
    string? theme = Context.Request.Cookies["theme"] is "light" or "dark" ? Context.Request.Cookies["theme"] : null;
}
<!DOCTYPE html>
<html lang="@L.Code" data-theme="@theme">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>@(ViewData["Title"] is string t ? t + " — SkyNetwork" : "SkyNetwork — " + L["virtual aviation network"])</title>
  <meta name="description" content="@L["SkyNetwork is a virtual aviation network: pilots and controllers in one sky."]">
  @if (path.StartsWith("/staff", StringComparison.OrdinalIgnoreCase)) { <meta name="robots" content="noindex, nofollow"> }
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64 256x256">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta property="og:image" content="@(Context.Request.Scheme + "://" + Context.Request.Host + "/img/logo.png")">
  <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
  <script src="~/js/theme.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Head", required: false)
</head>
<body>
  <div id="scroll-top" aria-hidden="true"></div>
  <header class="site-header" id="header">
    <div class="wrap">
      <a class="brand" href="/"><partial name="_Logo" /><span>Sky<span class="brand-net">Network</span></span></a>
      <button class="btn btn-small nav-toggle" type="button" aria-label="@L["Menu"]"
              onclick="document.getElementById('header').classList.toggle('open')">@L["Menu"]</button>
      <nav class="nav" aria-label="@L["Sections"]">
        <a href="/map" class="@Active("/map")">@L["Map"]</a>
        <a href="/online" class="@Active("/online")">@L["Online"]</a>
        <a href="/events" class="@Active("/events")">@L["Events"]</a>
        <a href="/bookings" class="@Active("/bookings")">@L["Bookings"]</a>
        <a href="/news" class="@Active("/news")">@L["News"]</a>
        <a href="/docs" class="@Active("/docs")">@L["Docs"]</a>
      </nav>
      <div class="user-nav">
        <partial name="_Preferences" model="here" />
        @if (Me.Member is { } m)
        {
          @if (Me.IsStaff) { <a href="/staff">@L["Management"]</a> }
          <a href="/account" class="me" title="@L["My account"] · @m.Name · CID @m.Cid"><span class="initials">@Format.Initials(m.Name)</span><span class="name">@m.Name</span></a>
          <form method="post" asp-page="/Logout"><button class="btn btn-small" type="submit">@L["Sign out"]</button></form>
        }
        else
        {
          <a href="/login">@L["Sign in"]</a>
          <a class="btn btn-primary btn-pill" href="/register">@L["Join"]</a>
        }
      </div>
    </div>
  </header>

  <main>
    @RenderBody()
  </main>

  @if (!(ViewData["HideFooter"] is true))
  {
    <footer class="site-footer">
      <div class="wrap">
        <span>© @DateTime.UtcNow.Year SkyNetwork · @L["virtual aviation network"]</span>
        <nav>
          <a href="/docs/software">@L["Software"]</a>
          <a href="/developers">API</a>
          <a href="/support">@L["Support"]</a>
        </nav>
      </div>
    </footer>
  }
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
