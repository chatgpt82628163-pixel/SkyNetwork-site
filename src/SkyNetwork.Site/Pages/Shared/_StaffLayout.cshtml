@inject SupportService Support
@inject DivisionService Divisions
@inject SkyNetwork.Site.Services.Health.HealthMonitor Health
@{
    Layout = "_Layout";
    string path = Context.Request.Path.Value ?? "";
    string A(string p) => (p == "/staff" ? path.Equals(p, StringComparison.OrdinalIgnoreCase) : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    int openTickets = Support.OpenTickets();
    int pendingRatings = Me.Has(Perm.ApproveRatings) ? Divisions.PendingCount() : 0;
    // Problems of the infrastructure right now, next to the status link.
    bool seesStatus = Me.Has(Perm.SystemStatus);
    var statusProblems = Health.Results.Where(r => seesStatus && r.Level >= SkyNetwork.Site.Services.Health.HealthLevel.Warning).ToList();
    bool statusDown = statusProblems.Any(r => r.Level == SkyNetwork.Site.Services.Health.HealthLevel.Error);
}
<div class="staff-bar">
  <div class="wrap">
    <b>@L["Network management"]</b>
    <span>· @Me.Member!.Name, @Me.Member.DisplayShort@(Me.Roles.Count > 0 ? " · " + string.Join(", ", Me.Roles.Select(r => L[Permissions.Roles[r]])) : "")</span>
  </div>
</div>
<div class="wrap page with-side">
  <nav class="side" aria-label="@L["Management"]">
    <div class="side-title">@L["Network"]</div>
    <a href="/staff" class="@A("/staff")">@L["Overview"]</a>
    @if (Me.Has(Perm.ViewMembers)) { <a href="/staff/members" class="@A("/staff/members")">@L["Members"]</a> }
    <a href="/staff/team" class="@A("/staff/team")">@L["Team"]</a>
    @if (Me.Has(Perm.Online)) { <a href="/staff/online" class="@A("/staff/online")">@L["On the air"]</a> }
    @if (Me.Has(Perm.SystemStatus)) { <a href="/staff/status" class="@A("/staff/status")">@L["Network status"] @if (statusProblems.Count > 0) { <span class="count @(statusDown ? "danger" : "warn")" title="@L["Problems right now"]">@statusProblems.Count</span> }</a> }
    @if (Me.Has(Perm.Tickets) || Me.Has(Perm.ApproveRatings)) { <div class="side-title">@L["Work"]</div> }
    @if (Me.Has(Perm.Tickets)) { <a href="/staff/tickets" class="@A("/staff/tickets")">@L["Support tickets"] @if (openTickets > 0) { <span class="count">@openTickets</span> }</a> }
    @if (Me.Has(Perm.ManageDivisions)) { <a href="/staff/connect" class="@A("/staff/connect")">@L["Sign-in for other sites"]</a> }
    @if (Me.Has(Perm.ManageAircraft)) { <a href="/staff/aircraft" class="@A("/staff/aircraft")">@L["Aircraft profiles"]</a> }
    @if (Me.Has(Perm.ApproveRatings)) { <a href="/staff/ratings" class="@A("/staff/ratings")">@L["Rating requests"] @if (pendingRatings > 0) { <span class="count">@pendingRatings</span> }</a> }
    @if (Me.Has(Perm.Events) || Me.Has(Perm.News) || Me.Has(Perm.Bookings)) { <div class="side-title">@L["Website"]</div> }
    @if (Me.Has(Perm.Events)) { <a href="/staff/events" class="@A("/staff/events")">@L["Events"]</a> }
    @if (Me.Has(Perm.News)) { <a href="/staff/news" class="@A("/staff/news")">@L["News"]</a> }
    @if (Me.Has(Perm.Bookings)) { <a href="/staff/bookings" class="@A("/staff/bookings")">@L["Bookings"]</a> }
    @if (Me.Has(Perm.Releases)) { <a href="/staff/releases" class="@A("/staff/releases")">@L["Releases"]</a> }
    @if (Me.Has(Perm.Audit)) { <div class="side-title">@L["Oversight"]</div><a href="/staff/audit" class="@A("/staff/audit")">@L["Audit log"]</a> }
  </nav>
  <div>
    @RenderBody()
  </div>
</div>
@section Head { @await RenderSectionAsync("Head", required: false) }
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
