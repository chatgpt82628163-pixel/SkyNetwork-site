@page "/docs"
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Options
@{ ViewData["Title"] = L["Getting started"]; var o = Options.Value; }
<div class="wrap page with-side">
  <partial name="_DocsNav" />
  <div class="prose">
    <h1 style="font-size:34px">@L["Getting started"]</h1>
    <p class="muted">@L["Everything you need for your first connection: an account and the software."]</p>

    <h2 style="font-size:22px;margin-top:32px">@L["For pilots"]</h2>
    <div class="steps" style="grid-template-columns:1fr">
      <div class="step"><h3>@L["Register"]</h3><p class="muted">@L["On the"] <a href="/register">@L["registration page"]</a> @L["you get a CID. Your CID and password are your SkyPilot login."]</p></div>
      <div class="step"><h3>@L["Install SkyPilot"]</h3><p class="muted">@L["The client for MSFS 2020 and 2024, X-Plane 11 and 12 and Prepar3D v4–v6."] <a href="/docs/software">@L["Download"]</a>. @L["In the settings enter your CID and password: the network address is built in."]</p></div>
      <div class="step"><h3>@L["File a flight plan"]</h3><p class="muted">@L["On the"] <a href="/flightplan">@L["flight plan page"]</a>. @L["Press “Refresh” in SkyPilot and the plan appears at the controllers."]</p></div>
      <div class="step"><h3>@L["Set up the radio"]</h3><p class="muted">@L["In the SkyPilot settings choose the microphone, speakers and the push-to-talk key. Voice connects together with the network; tune COM1 to the controller's frequency and hold the key to talk."]</p></div>
      <div class="step"><h3>@L["Connect and listen to the frequency"]</h3><p class="muted">@L["Check the"] <a href="/online">@L["online page"]</a> @L["to see who is working nearby. With no controller around, use UNICOM 122.800."]</p></div>
    </div>

    <h2 style="font-size:22px;margin-top:40px">@L["For controllers"]</h2>
    <div class="steps" style="grid-template-columns:1fr">
      <div class="step"><h3>@L["Get a rating"]</h3><p class="muted">@L["New members are observers (OBS): they can connect and listen but not control. Ratings are earned in the training center of your division."]</p></div>
      <div class="step"><h3>@L["Install Network-ATC"]</h3><p class="muted">@L["The controller radar with EuroScope sector files and its own .natc format."] <a href="/docs/software">@L["Download"]</a>.</p></div>
      <div class="step"><h3>@L["Book a position"]</h3><p class="muted">@L["In the"] <a href="/bookings">@L["schedule"]</a> @L["pilots will see when you are on the air."]</p></div>
    </div>
  </div>
</div>
