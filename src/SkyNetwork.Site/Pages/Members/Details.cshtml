@page "/members/{cid:long}"
@model SkyNetwork.Site.Pages.Members.DetailsModel
@{
    var m = Model.Member;
    ViewData["Title"] = m.Name;
}
<div class="wrap page">
  <div class="profile-head">
    <partial name="_Avatar" model="m" />
    <div>
      <h1 style="font-size:30px;margin:0">@m.Name</h1>
      <div class="muted">CID <span class="mono">@m.Cid</span>
        @if (m.Registered is { } r) { <span> · @L["member since"] @Format.Date(r)</span> }
        @if (m.Suspended) { <span class="badge danger">@L["suspended"]</span> }</div>
    </div>
    <div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">
      @if (Model.CanFriend)
      {
        <form method="post" asp-page-handler="Friend">
          <input type="hidden" name="add" value="@(Model.IsFriend ? "false" : "true")">
          <button class="btn btn-small" type="submit">@(Model.IsFriend ? "★ " + L["In your friends"] : "☆ " + L["Add to friends"])</button>
        </form>
      }
      @if (Me.Has(Perm.ViewMembers)) { <a class="btn btn-small" href="/staff/members/@m.Cid">@L["Open in management"]</a> }
    </div>
  </div>
  @if (m.Suspended)
  {
    <div class="alert error">@(m.SuspensionEnds is { } until
        ? L["This account is suspended until"] + " " + Format.Utc(until) + ". " + L["It cannot connect to the network."]
        : L["This account is suspended. It cannot connect to the network."])</div>
  }
  <partial name="_RatingBadges" model="m" />
  <div class="stats">
    <div class="stat"><b>@Format.Hours(Model.Hours.PilotHours)</b><span>@L["flying"]</span></div>
    <div class="stat"><b>@Format.Hours(Model.Hours.AtcHours)</b><span>@L["on position"]</span></div>
    <div class="stat"><b>@Model.Hours.PilotSessions</b><span>@L["flights"]</span></div>
    <div class="stat"><b>@Model.Hours.AtcSessions</b><span>@L["controlling sessions"]</span></div>
  </div>
  <div style="display:flex;align-items:baseline;gap:12px;margin-bottom:4px">
    <h2 style="font-size:20px;margin:0">@L["Recent connections"]</h2>
    <a href="/members/@m.Cid/logbook" class="muted" style="font-size:13px">@L["Full logbook"] →</a>
  </div>
  @if (Model.Sessions.Count == 0)
  {
    <div class="empty">@L["No connections yet."]</div>
  }
  else
  {
    <div class="table-wrap">
      <table>
        <thead><tr><th>@L["Callsign"]</th><th>@L["Role"]</th><th>@L["Start"]</th><th>@L["Duration"]</th></tr></thead>
        <tbody>
        @foreach (var s in Model.Sessions)
        {
          <tr><td class="mono">@s.Callsign</td><td>@(s.Kind == "atc" ? L["controller"] : L["pilot"])</td><td>@Format.Utc(s.Start)</td>
              <td>@Format.Duration(s.Duration)@(s.EndedAt == null ? " · " + L["on the air"] : "")</td></tr>
        }
        </tbody>
      </table>
    </div>
  }
</div>
