@page "/account-deleted"
@{ ViewData["Title"] = L["Account deleted"]; }
<div class="wrap page">
  <div class="auth-box">
    <h1 style="font-size:34px">@L["Account deleted"]</h1>
    <div class="alert ok">@L["Your account and everything the site kept about it are deleted. Thank you for flying with us."]</div>
    <p><a class="btn" href="/">@L["To the home page"]</a></p>
  </div>
</div>
