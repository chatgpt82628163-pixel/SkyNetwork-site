@page "/account"
@model SkyNetwork.Site.Pages.Account.IndexModel
@{
    ViewData["Title"] = L["My account"];
    var m = Me.Member!;
}
<div class="wrap page with-side">
  <partial name="_AccountNav" />
  <div>
    @if (Model.Welcome)
    {
      <div class="alert ok">
        <div>@L["Welcome to SkyNetwork! Your CID:"]</div>
        <div class="big-cid">@m.Cid</div>
        <div>@L["Write it down: with it and your password you sign in to the website and connect to the network. Next,"] <a href="/docs/software">@L["install the software"]</a>.</div>
      </div>
    }
    @if (!m.EmailVerified)
    {
      <div class="alert error">
        <div><b>@L["Confirm your email"]</b></div>
        <div>@L.F("We sent a link to {0}. Open it to confirm the address: until then you cannot connect to the network.", m.Email ?? "")</div>
        <div class="small" style="margin-top:4px">@L["No letter within a few minutes? Look in the Spam folder and mark it as not spam, so our next letters reach your inbox."]</div>
        @if (Model.Resent == true) { <div>@L["A new letter is on its way."]</div> }
        @if (Model.Resent == false) { <div>@L["A letter was sent a moment ago: wait two minutes before asking for another one."]</div> }
        <form method="post" asp-page-handler="Resend" class="inline-form" style="margin-top:8px">
          <button class="btn btn-small" type="submit">@L["Send the letter again"]</button>
          <a class="small" href="/account/settings">@L["Wrong address? Change it in the settings"]</a>
        </form>
      </div>
    }
    <div class="profile-head">
      <partial name="_Avatar" model="m" />
      <div>
        <h1 style="font-size:28px;margin:0">@m.Name</h1>
        <div class="muted">CID <span class="mono">@m.Cid</span></div>
      </div>
    </div>
    <partial name="_RatingBadges" model="m" />
    <div class="stats">
      <div class="stat"><b>@Format.Hours(Model.Hours.PilotHours)</b><span>@L["flying"]</span></div>
      <div class="stat"><b>@Format.Hours(Model.Hours.AtcHours)</b><span>@L["on position"]</span></div>
      <div class="stat"><b>@Model.Hours.PilotSessions</b><span>@L["flights"]</span></div>
      <div class="stat"><b>@Model.Hours.AtcSessions</b><span>@L["controlling sessions"]</span></div>
    </div>

    <div class="section-head"><h2>@L["Latest flight plan"]</h2><a href="/flightplan">@L["File a new one →"]</a></div>
    @if (Model.Plan is { } p)
    {
      <div class="card" style="margin-bottom:32px">
        <div class="mono" style="font-size:18px;font-weight:700">@p.Callsign</div>
        <div class="mono">@p.Departure → @p.Destination · @p.Aircraft · @p.CruiseAltitude · @p.Rules</div>
        <div class="muted small">@L.F("Filed {0}. SkyPilot picks it up when you press “Refresh”.", Format.Utc(p.Created))</div>
      </div>
    }
    else
    {
      <div class="empty" style="margin-bottom:32px">@L["No plans yet."] <a href="/flightplan">@L["File a plan"]</a></div>
    }

    <div class="section-head"><h2>@L["Recent sessions"]</h2></div>
    @if (Model.Sessions.Count == 0)
    {
      <div class="empty">@L["You have not connected to the network yet."]</div>
    }
    else
    {
      <div class="table-wrap">
        <table>
          <thead><tr><th>@L["Callsign"]</th><th>@L["Role"]</th><th>@L["Details"]</th><th>@L["Start"]</th><th>@L["Duration"]</th></tr></thead>
          <tbody>
          @foreach (var s in Model.Sessions)
          {
            <tr><td class="mono">@s.Callsign</td><td>@(s.Kind == "atc" ? L["controller"] : L["pilot"])</td><td class="mono small">@s.Details</td>
                <td>@Format.Utc(s.Start)</td><td>@Format.Duration(s.Duration)@(s.EndedAt == null ? " · " + L["on the air"] : "")</td></tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
