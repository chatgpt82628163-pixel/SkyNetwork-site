@page "/account/settings"
@model SkyNetwork.Site.Pages.Account.SettingsModel
@{ ViewData["Title"] = L["Settings"]; }
<div class="wrap page with-side">
  <partial name="_AccountNav" />
  <div>
    <h1 style="font-size:30px">@L["Settings"]</h1>
    @if (Model.Message != null) { <div class="alert ok">@L[Model.Message]</div> }
    @if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
    <h2 style="font-size:20px;margin-top:24px">@L["Profile picture"]</h2>
    <form method="post" asp-page-handler="Avatar" enctype="multipart/form-data" class="avatar-edit">
      <partial name="_Avatar" model="Model.Me" />
      <div class="form" style="flex:1;min-width:220px">
        <label>@L["JPEG, PNG or WebP, up to 2 MB; a square picture looks best."]<input name="avatar" type="file" accept="image/jpeg,image/png,image/webp"></label>
        <div class="inline-form">
          <button class="btn btn-primary" type="submit">@L["Upload"]</button>
          @if (Model.Me.Avatar.Length > 0) { <button class="btn" type="submit" name="remove" value="true">@L["Remove picture"]</button> }
        </div>
      </div>
    </form>
    <h2 style="font-size:20px;margin-top:40px">@L["Profile"]</h2>
    <p class="muted small">@L["Your name is changed through"] <a href="/account/support">@L["support"]</a> — @L["people recognise you by it on the air."]</p>
    <form method="post" asp-page-handler="Profile" class="form">
      <label>@L["Email"]<input name="Email" type="email" value="@Model.Email" required maxlength="120"></label>
      <label>@L["Country"]
        <select name="Country" autocomplete="country-name">
          <option value="">@L["Not specified"]</option>
          @{ var chosen = Countries.Normalize(Model.Country); }
          @if (Model.Country.Length > 0 && chosen == null) { <option value="@Model.Country" selected>@Model.Country</option> }
          @foreach (var (value, name) in Countries.List(L.IsRu))
          {
            <option value="@value" selected="@(chosen == value)">@name</option>
          }
        </select>
      </label>
      <div><button class="btn btn-primary" type="submit">@L["Save profile"]</button></div>
    </form>
    <h2 style="font-size:20px;margin-top:40px">@L["Password"]</h2>
    <p class="muted small">@L["One password for the website and for connecting to the network."]</p>
    <form method="post" asp-page-handler="Password" class="form">
      <label>@L["Current password"]<input name="Current" type="password" required autocomplete="current-password"></label>
      <label>@L["New password"]<input name="NewPassword" type="password" required minlength="8" autocomplete="new-password"></label>
      <label>@L["Repeat new password"]<input name="Confirm" type="password" required minlength="8" autocomplete="new-password"></label>
      <div><button class="btn btn-primary" type="submit">@L["Change password"]</button></div>
    </form>
    <h2 style="font-size:20px;margin-top:40px">@L["Connected sites"]</h2>
    <p class="muted small">@L["Sites you signed in to with your SkyNetwork account (SkyNetwork Connect). Withdrawn access means the site asks again next time."]</p>
    @if (Model.ConnectedSites.Count == 0) { <p class="muted">@L["None yet."]</p> }
    @foreach (var s in Model.ConnectedSites)
    {
      <form method="post" asp-page-handler="Revoke" class="inline-form" style="justify-content:space-between;border-bottom:1px solid var(--line);padding:8px 0">
        <span><b>@s.Name</b> <span class="muted small">@L["since"] @Format.Date(s.Created)</span></span>
        <input type="hidden" name="clientId" value="@s.ClientId">
        <button class="btn btn-small" type="submit">@L["Withdraw access"]</button>
      </form>
    }
  </div>
</div>
