@page "/planner"
@model PlannerModel
@{
    ViewData["Title"] = L["Flight planner"];
    ViewData["HideFooter"] = true;
}
@section Head {
  <link rel="stylesheet" href="~/lib/leaflet/leaflet.css">
  <link rel="stylesheet" href="~/css/planner.css" asp-append-version="true">
}
<div class="ps" id="ps" data-text="@PlannerTexts.Json(L)">
  <div id="ps-map" aria-label="@L["Route map"]"></div>

  <header class="ps-top ps-glass">
    <div class="ps-brand">@L["Flight planner"]</div>
    <div class="ps-top-main">
      <b id="ps-top-route">@L["New plan"]</b>
      <span id="ps-top-type" class="muted"></span>
      <span id="ps-top-busy" class="ps-busy-chip" hidden>@L["Calculating…"]</span>
      <span id="ps-top-warn" class="ps-warn-chip" hidden>⚠ <b>0</b></span>
      <span id="ps-top-stats" class="ps-top-stats"></span>
    </div>
    <div class="ps-top-actions">
      <a id="ps-charts" class="btn btn-small" href="https://chartfox.org/" target="_blank" rel="noopener">@L["Charts"]</a>
      <button type="button" id="ps-share" class="btn btn-small">@L["Share"]</button>
      <button type="button" id="ps-new-btn" class="btn btn-small btn-primary">@L["New plan"]</button>
    </div>
  </header>

  <div class="ps-left">
    <details class="ps-panel ps-glass ps-flight" id="ps-new" open>
      <summary><h3>@L["Flight"]</h3><span class="muted small">@L["departure, destination, aircraft"]</span></summary>
      <form id="ps-form" class="ps-form" autocomplete="off">
        <label>@L["Departure"]<input id="ps-dep" class="mono" maxlength="4" placeholder="UUEE" required></label>
        <label>@L["Destination"]<input id="ps-dest" class="mono" maxlength="4" placeholder="ULLI" required></label>
        <label>@L["Alternate"]<input id="ps-alt" class="mono" maxlength="4" placeholder="@L["auto"]"></label>
        <label class="wide">@L["Aircraft type"]
          <select id="ps-type" required>
            @foreach (var t in Model.Types)
            {
              <option value="@t.Icao" selected="@(t.Icao == "A320")">@t.Icao — @t.Name</option>
            }
          </select>
        </label>
        <label>@L["Callsign"]<input id="ps-callsign" class="mono" maxlength="10" placeholder="AFL1234"></label>
        <label class="wide">@L["Off-block time"]<input id="ps-time" type="datetime-local"></label>
        <button type="submit" class="btn btn-primary wide">@L["Calculate"]</button>
        <p id="ps-error" class="alert error wide" hidden></p>
      </form>
    </details>

    <section class="ps-panel ps-glass" id="ps-rwy">
      <div class="ps-panel-head"><h3>@L["Runways"]</h3>
        <div class="ps-seg" id="ps-rwy-tabs"><button type="button" data-tab="dep" class="on">@L["Departure"]</button><button type="button" data-tab="arr">@L["Destination"]</button></div>
      </div>
      <div id="ps-rwy-head" class="ps-rwy-head"><span class="muted small">@L["Make a plan to see the runways and the wind."]</span></div>
      <div id="ps-rwy-svg" class="ps-rwy-svg"></div>
      <div id="ps-rwy-list" class="ps-rwy-list"></div>
    </section>

    <section class="ps-panel ps-glass" id="ps-wx">
      <div class="ps-panel-head"><h3>@L["Weather"]</h3>
        <div class="ps-seg" id="ps-wx-kind"><button type="button" data-v="metar">METAR</button><button type="button" data-v="taf">TAF</button></div>
        <div class="ps-seg" id="ps-wx-raw"><button type="button" data-v="raw">@L["As sent"]</button><button type="button" data-v="words">@L["In words"]</button></div>
      </div>
      <div id="ps-wx-list"></div>
    </section>
  </div>

  <div class="ps-right">
    <section class="ps-panel ps-glass" id="ps-load">
      <div class="ps-panel-head"><h3>@L["Load and fuel"]</h3>
        <div class="ps-seg" id="ps-units"><button type="button" data-v="kg">kg</button><button type="button" data-v="lb">lb</button></div>
      </div>
      <div id="ps-ac-name" class="ps-ac-name muted"></div>
      <form id="ps-load-form" class="ps-load-form" autocomplete="off" data-auto-text="@L["auto"]">
        <label><span class="ps-lbl">@L["Cost index"]</span><input id="ps-ci" type="number" min="0" max="999"></label>
        <label><span class="ps-lbl">@L["Level FL"]</span><input id="ps-fl" type="number" min="10" max="510" step="10"></label>
        <label><span class="ps-lbl">@L["Passengers"]</span><input id="ps-pax" type="number" min="0" max="900"></label>
        <label><span class="ps-lbl">@L["Bags per pax"], <span class="ps-unit">kg</span></span><input id="ps-bag" type="number" min="0" max="220"></label>
        <label><span class="ps-lbl">@L["Cargo"], <span class="ps-unit">kg</span></span><input id="ps-cargo" type="number" min="0" max="450000"></label>
        <label><span class="ps-lbl">@L["Extra fuel"], <span class="ps-unit">kg</span></span><input id="ps-extra" type="number" min="0" max="220000"></label>
      </form>
      <div id="ps-fuel" class="ps-fuel"></div>
      <div id="ps-weights"></div>
      <ul id="ps-warnings" class="ps-warnings"></ul>
    </section>
  </div>

  <section class="ps-bottom ps-glass">
    <div class="ps-bottom-head">
      <div class="ps-tabs" id="ps-tabs">
        <button type="button" data-tab="route" class="on">@L["Route"]</button>
        <button type="button" data-tab="navlog">@L["Navigation log"]</button>
        <button type="button" data-tab="fuel">@L["Fuel"]</button>
        <button type="button" data-tab="summary">@L["Flight summary"]</button>
        <button type="button" data-tab="rt">@L["Phraseology"]</button>
        <button type="button" id="ps-collapse" class="ps-collapse" title="@L["Hide or show"]" aria-label="@L["Hide or show"]">▾</button>
      </div>
    </div>
    <div class="ps-tab" id="ps-tab-route">
      <div class="ps-route">
        <div class="ps-route-main">
          <div id="ps-route-text" class="ps-route-text mono"><span class="muted">@L["The route appears here."]</span></div>
          <div class="ps-route-actions">
            <button type="button" id="ps-copy" class="btn btn-small">@L["Copy"]</button>
            <button type="button" id="ps-pdf" class="btn btn-small">PDF OFP</button>
            <details class="ps-menu" id="ps-export">
              <summary class="btn btn-small">@L["Export"] ▾</summary>
              <div class="ps-menu-list">
                <button type="button" data-fmt="pln">.pln — MSFS 2020 / 2024</button>
                <button type="button" data-fmt="fms">.fms — X-Plane 11 / 12</button>
                <button type="button" data-fmt="txt">.txt — OFP</button>
              </div>
            </details>
            <a id="ps-file" class="btn btn-small btn-primary" href="/flightplan">@L["File the flight plan"]</a>
            <a id="ps-simbrief" class="btn btn-small" href="https://dispatch.simbrief.com/" target="_blank" rel="noopener">@L["Open in SimBrief"]</a>
            <span class="muted small">@L["Charts"]: <a id="ps-chart-dep" href="https://chartfox.org/" target="_blank" rel="noopener">—</a> · <a id="ps-chart-dest" href="https://chartfox.org/" target="_blank" rel="noopener">—</a></span>
          </div>
        </div>
        <div id="ps-variants" class="ps-variants"></div>
      </div>
    </div>
    <div class="ps-tab" id="ps-tab-navlog" hidden><div id="ps-navlog" class="ps-scroll"></div></div>
    <div class="ps-tab" id="ps-tab-fuel" hidden><div id="ps-fueltab" class="ps-scroll"></div></div>
    <div class="ps-tab" id="ps-tab-summary" hidden><div id="ps-summary" class="ps-scroll"></div></div>
    <div class="ps-tab" id="ps-tab-rt" hidden>
      <div class="ps-scroll">
        <div class="ps-rt-bar">
          <label>@L["Your callsign"]<input id="ps-rt-cs" class="mono" maxlength="10" placeholder="AFL1234" autocomplete="off"></label>
          <label>@L["Stand"]<input id="ps-rt-stand" class="mono" maxlength="5" placeholder="25" autocomplete="off"></label>
          <p id="ps-rt-say" class="ps-rt-say"></p>
        </div>
        <div id="ps-rt"><p class="muted small">@L["Make a plan to get the phrases for your flight."]</p></div>
      </div>
    </div>
  </section>

  <nav class="ps-dock ps-glass" id="ps-dock">
    <button type="button" data-panel="ps-new">@L["Flight"]</button>
    <button type="button" data-panel="ps-load">@L["Load and fuel"]</button>
    <button type="button" data-panel="ps-wx">@L["Weather"]</button>
    <button type="button" data-panel="ps-rwy">@L["Runways"]</button>
    <button type="button" data-panel="ps-tabs">@L["Route"]</button>
  </nav>

  <div class="ps-busy" aria-hidden="true"><span></span></div>
  <p class="ps-note muted small">@L["For the simulator only. Not for real-world navigation."]</p>
  <pre id="ps-ofp" class="ps-ofp"></pre>
</div>
@section Scripts {
  <script src="~/lib/leaflet/leaflet.js"></script>
  <script src="~/js/planner.js" asp-append-version="true"></script>
}
