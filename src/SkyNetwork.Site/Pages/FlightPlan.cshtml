@page "/flightplan"
@model FlightPlanModel
@{ ViewData["Title"] = L["Flight plan"]; var p = Model.Plan; }
<div class="wrap page with-side">
  <partial name="_AccountNav" />
  <div>
    <h1 style="font-size:30px">@L["Flight plan"]</h1>
    <p class="muted">@L["File your plan before connecting. Press “Refresh” in SkyPilot and the plan goes to the controllers. While you are online SkyPilot checks the website every 30 seconds."] <a href="/planner">@L["Need a route? Try the planner."]</a></p>
    @if (Model.Saved) { <div class="alert ok">@L["Plan filed. Press “Refresh” in SkyPilot."]</div> }
    @if (Model.Error != null) { <div class="alert error">@L[Model.Error]</div> }
    @if (Model.Imported) { <div class="alert ok">@L["Plan loaded from SimBrief. Check the fields and press “File plan”."]</div> }
    <form method="post" asp-page-handler="Simbrief" class="card simbrief-box">
      <div>
        <h3 style="margin:0 0 2px">@L["SimBrief import"]</h3>
        <div class="muted small">@L["We take your latest SimBrief plan with every route point; they appear on the map. Afterwards the map finds your SimBrief route by itself, however you file."]</div>
      </div>
      <div class="inline-form">
        <label>@L["Username or Pilot ID"]<input name="simbriefUser" value="@Model.SimbriefUser" required maxlength="64" autocomplete="off"></label>
        <button class="btn" type="submit">@L["Load"]</button>
      </div>
    </form>
    @* The plan form always posts to the filing handler: after a SimBrief import the page sits at ?handler=Simbrief. *@
    <form method="post" asp-page="/FlightPlan" class="form wide">
      <input type="hidden" name="Plan.Waypoints" value="@p.Waypoints">
      <div class="row">
        <label>@L["Callsign"]<input name="Plan.Callsign" value="@p.Callsign" class="mono" required maxlength="10" pattern="[A-Za-z0-9]{2,10}"></label>
        <label>@L["Flight rules"]
          <select name="Plan.Rules">
            <option value="IFR" selected="@(p.Rules == "IFR")">@L["IFR — instruments"]</option>
            <option value="VFR" selected="@(p.Rules == "VFR")">@L["VFR — visual"]</option>
          </select>
        </label>
        <label>@L["Aircraft type"]<input name="Plan.Aircraft" value="@p.Aircraft" class="mono" required maxlength="8" placeholder="A20N"></label>
        <label>@L["Speed, knots"]<input name="Plan.CruiseSpeed" value="@(p.CruiseSpeed == 0 ? "" : p.CruiseSpeed)" inputmode="numeric" required></label>
      </div>
      <div class="row">
        <label>@L["Departure"]<input name="Plan.Departure" value="@p.Departure" class="mono" required maxlength="4" placeholder="UUEE">
          @if (System.Text.RegularExpressions.Regex.IsMatch(p.Departure, @"^[A-Z0-9]{4}$")) {
            <span class="hint"><a href="https://chartfox.org/@p.Departure" target="_blank" rel="noopener">@L["Charts"]</a></span>
          }</label>
        <label>@L["Destination"]<input name="Plan.Destination" value="@p.Destination" class="mono" required maxlength="4" placeholder="ULLI">
          @if (System.Text.RegularExpressions.Regex.IsMatch(p.Destination, @"^[A-Z0-9]{4}$")) {
            <span class="hint"><a href="https://chartfox.org/@p.Destination" target="_blank" rel="noopener">@L["Charts"]</a></span>
          }</label>
        <label>@L["Alternate"]<input name="Plan.Alternate" value="@p.Alternate" class="mono" maxlength="4">
          @if (p.Alternate.Length == 4 && System.Text.RegularExpressions.Regex.IsMatch(p.Alternate, @"^[A-Z0-9]{4}$")) {
            <span class="hint"><a href="https://chartfox.org/@p.Alternate" target="_blank" rel="noopener">@L["Charts"]</a></span>
          }</label>
        <label>@L["Departure, UTC"]<input name="Plan.DepartureTime" value="@p.DepartureTime" class="mono" required maxlength="4" placeholder="1200"></label>
      </div>
      <div class="row">
        <label>@L["Cruise level"]<input name="Plan.CruiseAltitude" value="@p.CruiseAltitude" class="mono" required maxlength="6" placeholder="FL350"></label>
        <label>@L["En route, h:mm"]<input name="Enroute" value="@Model.Enroute" class="mono" required maxlength="5" placeholder="02:20" title="@L["Hours and minutes: 02:20 or 0220"]"></label>
        <label>@L["Fuel, h:mm"]<input name="Fuel" value="@Model.Fuel" class="mono" required maxlength="5" placeholder="03:30" title="@L["Hours and minutes: 02:20 or 0220"]"></label>
      </div>
      <label>@L["Route"]<textarea name="Plan.Route" class="mono" required maxlength="1000" style="min-height:80px">@p.Route</textarea>
        @if (p.Waypoints.Length > 0) { <span class="hint">@L["The SimBrief route points are saved with the plan and shown on the map."]</span> }</label>
      <label>@L["Remarks"]<input name="Plan.Remarks" value="@p.Remarks" maxlength="300">
        <span class="hint">@L["/V/ voice, /R/ receive only, /T/ text only."]</span></label>
      <div><button class="btn btn-primary" type="submit">@L["File plan"]</button></div>
    </form>
  </div>
</div>
