<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkyNetwork.Site</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Run on a newer runtime (9, 10, ...) when .NET 8 is not installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkyNetwork.Site.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled waypoint and airway files (see Nav/README.txt). -->
    <Content Include="Nav/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Aircraft performance profiles (OpenAP, LGPL-3.0; see LICENCES/openap.txt). -->
    <Content Include="Aircraft/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
